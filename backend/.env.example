# Application
APP_NAME=Healthcare Appointment Manager
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Database (SQLAlchemy 2 + psycopg3)
DATABASE_URL=postgresql+psycopg://healthcare:healthcare@localhost:5432/healthcare

# Redis
REDIS_URL=redis://localhost:6379/0

# Slot hold (Phase 3). Default 5 minutes.
HOLD_TTL_SECONDS=300

# Email (Phase 8). console = log to stdout; sendgrid = production.
EMAIL_BACKEND=console
SENDGRID_API_KEY=

# LLM (Phase 6). Provider is abstracted; keys never belong in source.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Google OAuth / Calendar (Phase 9)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Admin seeding (development only)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
